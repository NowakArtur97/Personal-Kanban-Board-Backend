interface BaseTaskEvent {
    taskEventType: TaskEventType!
    task: BaseTaskResponse
    taskId: UUID
}

type TaskEvent implements  BaseTaskEvent{
    taskEventType: TaskEventType!
    task: TaskResponse
    taskId: UUID
}

type SubtaskEvent implements  BaseTaskEvent{
    taskEventType: TaskEventType!
    task: SubtaskResponse
    taskId: UUID
}

enum TaskEventType {
    CREATE
    UPDATE
    DELETE
}
